# ── Datasets & model outputs (large, regenerable/redownloadable) ──
data/
results/
*.pt
*.onnx
*.engine

# ── Weights that ARE the deliverable live in models/ (force-tracked below) ──
!models/**/*.pt

# ── Python ──
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.venv/

# ── Node / frontend build ──
node_modules/
dist/
.vite/

# ── Runtime / local state ──
*.db
webapp/backend/uploads/

# ── Regenerable build artifacts (HF Space packages) ──
deployment/huggingface/space/
webapp/hf_space/

# ── Regenerable run visualizations (keep only metrics json/csv/yaml) ──
notebooks/runs/
experiments/**/*.png
experiments/**/*.jpg
experiments/**/*.jpeg
