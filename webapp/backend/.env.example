# Copy to .env and adjust. All values have safe dev defaults.
APP_NAME=SteelVision
ENVIRONMENT=development

# Dev: SQLite (zero-config). Prod: postgresql+psycopg://user:pass@host:5432/steelvision
DATABASE_URL=sqlite:///./steelvision.db

# CHANGE THIS in production (any long random string).
SECRET_KEY=dev-secret-change-me-in-production-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML
WEIGHTS_PATH=results/baseline_640/weights/best.pt
ENABLE_CAM=true

# Optional: bilingual report LLM (else KB fallback). See src/report/report_generator.py
# STEEL_LLM_BASE_URL=http://localhost:11434/v1
# STEEL_LLM_MODEL=mimo-7b-rl
